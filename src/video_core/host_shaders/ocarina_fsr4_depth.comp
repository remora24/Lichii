#version 450

// Convert Lichii's standard [0,1] Ocarina depth to reversed-Z before passing
// it to the BeamNG-derived FSR 4.1.2 prepass. Input is depth-sampled D32;
// output is sampled R32_SFLOAT. The FSR shader needs numeric depth, not the
// depth-attachment aspect or stencil state.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D standard_depth;
layout(binding = 1, r32f) uniform writeonly image2D reversed_depth;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(reversed_depth)))) {
        return;
    }
    float z = texelFetch(standard_depth, pixel, 0).r;
    imageStore(reversed_depth, pixel, vec4(1.0 - z, 0.0, 0.0, 0.0));
}
